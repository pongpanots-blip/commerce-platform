# Commerce Platform — environment
# Copy to .env (repo root) and adjust. This service uses its OWN Postgres
# database, separate from apps/backend.

# --- Database (either a URL, or the discrete vars below) ---
# COMMERCE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/commerce_db
COMMERCE_DB_HOST=localhost
COMMERCE_DB_PORT=5432
COMMERCE_DB_USERNAME=postgres
COMMERCE_DB_PASSWORD=postgres
COMMERCE_DB_NAME=commerce_db
COMMERCE_DB_SSL=false
COMMERCE_DB_LOGGING=false

# --- Redis (BullMQ queues) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- HTTP ---
PORT=3100

# --- Marketing Analyst (disabled until both key and model are configured) ---
OPENAI_API_KEY=
# Must support Responses API, web_search and structured outputs.
MARKETING_ANALYST_MODEL=
# Existing Growth drafts; also used as the analyst model fallback.
GROWTH_AI_MODEL=
# External MCP/OAuth endpoint; leaving blank disables external MCP.
MCP_PUBLIC_URL=
