{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "outDir": "../../dist/out-tsc",
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@cp/ui": [
        "../../libs/ui/src/index.tsx"
      ],
      "@cp/growth": [
        "../../libs/growth/src/index.d.ts"
      ],
      "@cp/marketing-workflow": [
        "../../libs/marketing-workflow/src/index.d.ts"
      ],
      "@josh/shared-api": [
        "src/josh-admin/libs/shared-api/index.ts"
      ],
      "@josh/shared-ui-web": [
        "src/josh-admin/libs/shared-ui-web/index.ts"
      ],
      "@josh/shared-models": [
        "src/josh-admin/libs/shared-models/index.ts"
      ]
    }
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx"
  ],
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
