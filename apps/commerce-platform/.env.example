# Commerce Platform — environment
# Copy to .env (repo root) and adjust. This service uses its OWN Postgres
# database, separate from apps/backend.

# --- Database (either a URL, or the discrete vars below) ---
# COMMERCE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/commerce_db
COMMERCE_DB_HOST=localhost
COMMERCE_DB_PORT=5432
COMMERCE_DB_USERNAME=postgres
COMMERCE_DB_PASSWORD=postgres
COMMERCE_DB_NAME=commerce_db
COMMERCE_DB_SSL=false
COMMERCE_DB_LOGGING=false

# --- Redis (BullMQ queues) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- HTTP ---
PORT=3100

# --- ERP feed (PUT /api/erp/products/{qty,price,moq}) ---
# Same value josh uses for X-ERP-Key. Unset in production = every ERP call is rejected.
ERP_WEBHOOK_KEY=
# Integration row (type "erp") the feed is staged under — create it once in admin.
ERP_INTEGRATION_SLUG=erp
# Warehouse code used when the ERP item has no WAREHOUSE_CODE.
ERP_DEFAULT_WAREHOUSE_CODE=MAIN

# --- Staff auth (commerce-admin) ---
# Every admin/integration route needs a staff token (default-deny). Signs both
# staff and portal tokens; REQUIRED in production (unset → all staff/portal auth fails closed).
PORTAL_JWT_SECRET=
# Sign-in lifetimes (staff + portal). Access JWT in seconds (default 900 = 15 min);
# rotating refresh token in days (default 30, sliding).
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# AUTH_REFRESH_TOKEN_TTL_DAYS=30
# Absolute cap on one sign-in, however often it is refreshed (default 90 days).
# AUTH_REFRESH_TOKEN_FAMILY_MAX_DAYS=90
# First admin:  STAFF_PASSWORD=... npm run create-staff -- you@jagota.com admin
# Developer-portal self-signup (POST /api/v1/portal/auth/register). Off by default:
# register answers 403 unless this is "true" or "1". Existing accounts, login and keys are unaffected.
# PORTAL_SELF_REGISTER=false
# Developer accounts approved to CREATE storefront keys (POST /api/v1/portal/keys): comma-separated
# account ids (users.id). Unset = nobody can create new keys (403); "*" = any account (dev/e2e only).
# Listing, revoking and every key already issued (josh's included) are unaffected.
# PORTAL_KEY_MINT_ACCOUNT_IDS=

# --- Scraping internal API (josh → commerce-platform) ---
# Shared secret for internal API calls (GET/POST /api/internal/scraping/*).
# Unset in production = all internal API calls rejected (401).
COMMERCE_INTERNAL_KEY=
# Disable cron: uncomment to pause 15s scraping tick (for testing).
# SCRAPING_CRON_DISABLED=true
# Site logins (our own member accounts): AES-256-GCM key, 32 bytes base64 (openssl rand -base64 32).
# Unset = saving a site password is refused. Changing it means re-entering every site password.
SCRAPING_CREDENTIALS_KEY=
# Same as josh appConfig.scraping: Chromium sessions at once, and the night window (Bangkok hours) for night-only sites.
# SCRAPING_MAX_BROWSER_SESSIONS=2
# SCRAPING_NIGHT_START_HOUR=0
# SCRAPING_NIGHT_END_HOUR=6

# --- josh catalog copy + competitor price comparison (moved from josh) ---
# Read-only josh DB (the read replica, SELECT-only role). Unset = no catalog sync.
# Winback's sales app no longer needs it (stage 2c). Still read by (stage 5 moves the reports to copies —
# docs/superpowers/plans/2026-10-08-stage5-data-jobs.md): /reports/* shop reports, reports/winback, restaurants, sales, growth and orders (unless their *_SOURCE=copies), MCP shop
# tools, catalog sync, order-copy / jagota copiers and shadows, WinbackMirror, and the one-off import / parity CLIs.
# Create it with: JOSH_PG_ADMIN_URL=<primary admin url> COMMERCE_PG_HOST=<replica host> node scripts/josh-postgres-readonly-user.mjs
JOSH_DATABASE_URL=
# josh's log Mongo (josh_logs: ERP inbound log, push-campaign delivery results), READ-ONLY user.
# Create it with: JOSH_MONGO_ROOT_URL=... COMMERCE_MONGO_HOST=<private ip> node scripts/josh-mongo-readonly-user.mjs
# Open josh's Mongo port only to commerce's security group / private IP — never the internet.
JOSH_MONGO_URL=
# CRON_JOSH_CATALOG_SYNC=*/15 * * * *
# CRON_JOSH_CATALOG_SYNC_ENABLED=true
# Off until cutover — josh refreshes its own copy until then.
CRON_COMPETITOR_PRICES_REFRESH_ENABLED=false
# CRON_COMPETITOR_PRICES_REFRESH=0 3 * * *

# --- Marketing Research (moved from josh) ---
# The external research worker calls /api/marketing-research-worker/* with this bearer (≥32 chars).
RESEARCH_WORKER_ENABLED=false
RESEARCH_WORKER_TOKEN=
RESEARCH_ENABLED_SOURCES=google
# Built-in free collector (TAT + OpenStreetMap). false until cutover — josh runs its own until then.
RESEARCH_FREE_WORKER_ENABLED=false
CRON_MARKETING_RESEARCH=* * * * *
CRON_MARKETING_RESEARCH_ENABLED=true
# AI summary runs only when Marketing clicks summarize. Backend secrets only; never send keys to the admin.
# Daily caps are per process here (no shared REDIS_CLIENT in commerce) — fine for one instance.
# RESEARCH_AI_ENABLED=true
# RESEARCH_GEMINI_API_KEYS= # JSON string array or comma-separated keys, priority order, max 5. Falls back to GEMINI_API_KEY.
# RESEARCH_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# RESEARCH_AI_DAILY_CALL_LIMIT=24
# Social research: free sources first; keys never go to the frontend.
# RESEARCH_SOCIAL_ENABLED=true
# RESEARCH_GOOGLE_NEWS_ENABLED=true # Public RSS titles/links only, no key.
# RESEARCH_PUBLIC_SOCIAL_RSS_ENABLED=true # Indexed public Facebook/Instagram/TikTok titles/links only; no platform API.
# RESEARCH_YOUTUBE_API_KEYS= # comma-separated, max 5; YouTube Data API v3.
# RESEARCH_YOUTUBE_DAILY_CALL_LIMIT=24
# RESEARCH_APIFY_ENABLED=false # optional Actor Tasks; keep disabled for free-only operation.
# RESEARCH_APIFY_API_TOKEN=
# RESEARCH_APIFY_TASKS=
# RESEARCH_APIFY_DAILY_RUN_LIMIT=4
# RESEARCH_APIFY_MAX_RUN_USD=0.05
# RESEARCH_APIFY_MONTHLY_BUDGET_USD=4

# --- MCP server for AI connectors (Claude / ChatGPT), read-only ---
# Public https origin AI clients reach (no path). Unset = MCP off.
# Serves /mcp, /authorize, /token, /register, /revoke, /mcp/oauth/login and /.well-known/oauth-* at the origin root.
MCP_PUBLIC_URL=
# Number of reverse proxies in front (e.g. 1 behind nginx) so rate limits see the real client IP — applies to the whole app
# (MCP login and the public POST /api/events ingest); set it in production behind nginx.
TRUST_PROXY_HOPS=

# --- Customer metrics (stage 2a): computed nightly here from josh_orders (order.snapshot copy), no josh DB read ---
# josh's API base (private network) + the same secret as josh's COMMERCE_EVENTS_SECRET.
JOSH_API_URL=
JOSH_EVENTS_SECRET=
# Opt-in. Runs 02:30 BKK, before josh's own 03:00 reconcile (which skips when josh has CUSTOMER_METRICS_OFFLOADED=true and this delivered < 26 h ago).
CRON_JOSH_CUSTOMER_METRICS_ENABLED=false
# CRON_JOSH_CUSTOMER_METRICS=30 2 * * *
# off = compute here only · shadow = josh compares and logs differences, writes nothing · on = josh applies them
CUSTOMER_METRICS_TO_JOSH=off
# Segments (stage 2a): true once josh has COMMERCE_OWNS_CUSTOMERS=true — commerce-admin's segment writes come here,
# freeze from the copies and reach josh as segment.* events (add them to josh's webhook subscription).
COMMERCE_OWNS_SEGMENTS=false
# Sales-rep assignment (stage 2b): true together with josh COMMERCE_OWNS_CUSTOMERS — CS "assign sales rep" writes here
# and josh's company.assigned_sales_user_id follows (company.sales_rep). Import first: npm run import-from-josh -- sales-reps
COMMERCE_OWNS_SALES_REPS=false
# Stock (stage 3): josh orders (order.snapshot) deduct this warehouse when it is commerce-owned (stock_source = commerce);
# unset = orders do not move stock (ERP warehouses already count orders in the ERP).
# STOCK_ORDER_WAREHOUSE_CODE=
# ERP calls josh took while commerce was down (erp.fallback.received) → ledger, every minute.
CRON_ERP_FALLBACK_REPLAY_ENABLED=false
# Product prices (stage 4a): true together with josh COMMERCE_OWNS_PRICES — ERP price / MOQ wait in commerce's MER queue
# (commerce-admin → ราคาสินค้า), approved / edited prices reach josh as product.price.snapshot.
# Import first: npm run import-from-josh -- prices ; check: npm run price-parity
COMMERCE_OWNS_PRICES=false
# Product content (stage 4b): true once josh runs COMMERCE_OWNS_CATALOG=true — names / descriptions, ingredients, cost …
# edited in the product form are kept here and reach josh as product.content.snapshot (the rest of the form still goes to josh).
# Import first: npm run import-from-josh -- contents ; check: npm run content-parity
COMMERCE_OWNS_PRODUCT_CONTENT=false
# Category tree and brand names (stage 4c): true together with josh COMMERCE_OWNS_CATEGORIES — the hosted josh category /
# brand pages write here (josh's rules) and every change reaches josh as category.tree.snapshot / brand.snapshot.
# Import first: npm run import-from-josh -- categories ; check: npm run category-parity
COMMERCE_OWNS_CATEGORIES=false
# ERP product master (stage 4d): true together with josh COMMERCE_OWNS_PRODUCT_MASTER — ERP product upserts of live SKUs wait in
# commerce's queue (commerce-admin → คิวข้อมูลสินค้าจาก ERP); approved / edited values reach josh as product.master.snapshot.
# Import first: npm run import-from-josh -- masters ; check: npm run master-parity
COMMERCE_OWNS_PRODUCT_MASTER=false
# Product galleries (stage 4e): true together with josh COMMERCE_OWNS_PRODUCT_IMAGES — product-page images and bulk image upload
# write here (files to josh's bucket: S3_MEDIA_BUCKET / AWS_* / MEDIA_BASE_URL, same as winback photos) and reach josh as
# product.images.snapshot. Import first: npm run import-from-josh -- images ; check: npm run image-parity
COMMERCE_OWNS_PRODUCT_IMAGES=false
# josh staff accounts (stage 6): true together with josh COMMERCE_OWNS_STAFF — role / on-off / sign-out of josh staff
# (sales app, CS chat, josh-only pages) are set at commerce-admin › บัญชี josh and reach josh as staff.access; the sales
# app sign-in here honours them at once. Needs the staff copy first (josh backfill staff). Off = read-only page, 409 on writes.
COMMERCE_OWNS_STAFF=false
# Ordering / logistics (stage 4f): true together with josh COMMERCE_OWNS_ORDERING — ERP order-period pushes update commerce's
# supplier rounds (commerce-admin → รอบสั่งซื้อ supplier) and reach josh as supplier.order_periods.snapshot; the product
# form's unit ratio / sub-packing / product unit / expected restock / delivery weekdays reach josh as product.logistics.snapshot.
# Import first: npm run import-from-josh -- ordering ; check: npm run ordering-parity
COMMERCE_OWNS_ORDERING=false
# Bestseller ranking for josh (Task 9): every 10 min on the replica; josh keeps each push 1h, else runs its own query
CRON_JOSH_BESTSELLERS_ENABLED=false
# CRON_JOSH_BESTSELLERS=0 */10 * * * *
# Where the ranking comes from (stage 5): replica (default) · shadow = push the replica's list and log
# "bestsellers shadow (copies vs replica)" · copies = josh_orders / josh_order_lines only, JOSH_DATABASE_URL not needed
BESTSELLERS_SOURCE=replica
# winback manager reports (/reports/winback/*, MCP winback_*): replica (default, josh's report code on the replica) ·
# copies = commerce's winback tables (the ones /winback/* serves the sales app), JOSH_DATABASE_URL not needed
WINBACK_REPORTS_SOURCE=replica
# Market Explorer (/reports/restaurants*, MCP restaurant_places): replica (default) · copies = josh_restaurant_places
# + commerce's winback_account, JOSH_DATABASE_URL not needed. Compare first: GET /reports/restaurants/parity
RESTAURANTS_SOURCE=replica
# Sales report (/reports/sales, MCP shop_sales, growth's sales figures): replica (default) · copies = josh_orders /
# josh_order_lines + commerce customer_metrics + josh_order_refunds (S5-11). Compare first: GET /reports/sales/parity
SALES_SOURCE=replica
# Growth workspace / results / company timeline: replica (default) · copies = order copies + commerce winback + the
# marketing workflow copy (carts, devices and per-company workflow enrollments show "not copied")
GROWTH_SOURCE=replica
# Orders report (/reports/orders*, MCP josh_orders): replica (default) · copies = josh_orders / josh_order_lines /
# josh_companies / josh_branches / josh_order_payments / josh_order_shipments / jagota_order_sync_history (S5-11 fields;
# backfill branch, company, jagota_sync, order first)
ORDERS_SOURCE=replica
# Products report (/reports/products*, MCP josh_products): replica (default) · copies = josh_catalog_products (S5-11
# fields) + commerce's own prices / approval queues / galleries / content / categories where COMMERCE_OWNS_* is on.
# Switch after the catalog backfill: GET /reports/products/summary → missing_report_fields = 0
PRODUCTS_SOURCE=replica
# Push campaigns report (/reports/push-campaigns*, MCP push_campaigns): replica (default) · copies = josh_push_campaigns
# (push_campaign.snapshot, S5-12). Delivery results still need JOSH_MONGO_URL either way
PUSH_CAMPAIGNS_SOURCE=replica
# Marketing workflows report (/reports/marketing-workflows*, MCP): replica (default) · copies = josh_marketing_workflows
# (marketing_workflow.snapshot, S5-12; counts by Bangkok day). Changes still go to josh (JoshActions) either way
MARKETING_WORKFLOWS_SOURCE=replica

# Alerts when events stop reaching platforms (josh): queue waiting too long, dead-letters, relay stuck.
# Any webhook that accepts {"text": "..."} — Slack / Google Chat / Teams incoming webhook. Empty = log only.
# Uptime monitors can poll GET /api/health/delivery (200 ok / 503 problem).
ALERT_WEBHOOK_URL=
# DELIVERY_ALERT_LAG_SECONDS=60
# OUTBOX_ALERT_LAG_SECONDS=30

# ERP simulator (admin → ERP simulator): sends real ERP calls through commerce to every platform.
# Always on outside production; on production only when set to true.
# ERP_SIMULATOR_ENABLED=false

# --- Orders -> Jagota through commerce, step 2 (josh JAGOTA_VIA_COMMERCE_BRANCHES routes branches here) ---
# Off unless true AND the Jagota API below is set; while off commerce answers 503 and josh sends directly.
JAGOTA_GATEWAY_ENABLED=false
# Same values as josh's. Staging: https://nodeapi-staging.jagota.com — prod files REAL orders.
JAGOTA_NODEAPI_BASE_URL=
JAGOTA_NODEAPI_USERNAME=
JAGOTA_NODEAPI_PASSWORD=

# --- Winback (the saleactivity sales app) run by commerce — docs/headless-split-plan.md "winback" ---
# josh (default): commerce mirrors josh's winback tables and refuses writes. commerce: commerce writes,
# runs the notify crons, mirrors its rows back to josh (`winback.row`). Flip with josh WINBACK_OWNED_BY_COMMERCE.
WINBACK_OWNER=josh
# josh's JWT_SECRET: the app keeps signing in at josh and sends josh's access token here.
JOSH_JWT_SECRET=
# Mirror josh ↔ commerce every 5 minutes (direction follows WINBACK_OWNER).
CRON_WINBACK_MIRROR_ENABLED=false
# Field-visit GPS (`GET /winback/visit-gps`, `/reports/winback/gps-visits`): a check-in this close (metres)
# to the customer's pin counts as on site. Default 200.
WINBACK_VISIT_RADIUS_M=200
# Notify crons (only while WINBACK_OWNER=commerce) — same names / defaults as josh.
CRON_WINBACK_APPOINTMENTS_DUE_ENABLED=false
CRON_WINBACK_DAILY_DIGEST_ENABLED=false
CRON_WINBACK_AGING_LEADS_ENABLED=false
# WINBACK_APPOINTMENT_REMINDER_MINUTES=60
# WINBACK_LEAD_AGING_DAYS=3
# External lead form key (X-Winback-Key) — same value as josh's.
WINBACK_INTAKE_KEY=
# Activity photos: josh's media bucket / env names (no S3 → upload answers 503).
S3_MEDIA_BUCKET=
AWS_REGION=ap-southeast-7
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# MEDIA_BASE_URL=

# Winback sales app sign-in: commerce staff JWTs (sale / sales_manager / admin) are always accepted.
# Josh JWTs are a fallback during the cutover; set false once every rep signs in with a commerce account.
WINBACK_ACCEPT_JOSH_JWT=true

# Commerce marketing workflows (phase 1): AES-256-GCM key for webhook header secrets (32 bytes, base64: `openssl rand -base64 32`).
MARKETING_WEBHOOK_SECRETS_KEY=
# Minute sweep (due waits, lost jobs, scheduled triggers). Default on; set false to stop commerce workflows from running.
CRON_MARKETING_WORKFLOW_ENABLED=true
# Public behaviour-event ingest POST /api/events (spec 2026-10-10-marketing-event-layer). Off unless "true".
MARKETING_EVENTS_INGEST_ENABLED=false
