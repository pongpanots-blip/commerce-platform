# Commerce Platform — environment
# Copy to .env (repo root) and adjust. This service uses its OWN Postgres
# database, separate from apps/backend.

# --- Database (either a URL, or the discrete vars below) ---
# COMMERCE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/commerce_db
COMMERCE_DB_HOST=localhost
COMMERCE_DB_PORT=5432
COMMERCE_DB_USERNAME=postgres
COMMERCE_DB_PASSWORD=postgres
COMMERCE_DB_NAME=commerce_db
COMMERCE_DB_SSL=false
COMMERCE_DB_LOGGING=false

# --- Redis (BullMQ queues) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- HTTP ---
PORT=3100

# --- ERP feed (PUT /api/erp/products/{qty,price,moq}) ---
# Same value josh uses for X-ERP-Key. Unset in production = every ERP call is rejected.
ERP_WEBHOOK_KEY=
# Integration row (type "erp") the feed is staged under — create it once in admin.
ERP_INTEGRATION_SLUG=erp
# Warehouse code used when the ERP item has no WAREHOUSE_CODE.
ERP_DEFAULT_WAREHOUSE_CODE=MAIN

# --- Staff auth (commerce-admin) ---
# Every admin/integration route needs a staff token (default-deny). Signs both
# staff and portal tokens; REQUIRED in production (unset → all staff/portal auth fails closed).
PORTAL_JWT_SECRET=
# First admin:  STAFF_PASSWORD=... npm run create-staff -- you@jagota.com admin

# --- Scraping internal API (josh → commerce-platform) ---
# Shared secret for internal API calls (GET/POST /api/internal/scraping/*).
# Unset in production = all internal API calls rejected (401).
COMMERCE_INTERNAL_KEY=
# Disable cron: uncomment to pause 15s scraping tick (for testing).
# SCRAPING_CRON_DISABLED=true
# Site logins (our own member accounts): AES-256-GCM key, 32 bytes base64 (openssl rand -base64 32).
# Unset = saving a site password is refused. Changing it means re-entering every site password.
SCRAPING_CREDENTIALS_KEY=
# Same as josh appConfig.scraping: Chromium sessions at once, and the night window (Bangkok hours) for night-only sites.
# SCRAPING_MAX_BROWSER_SESSIONS=2
# SCRAPING_NIGHT_START_HOUR=0
# SCRAPING_NIGHT_END_HOUR=6

# --- josh catalog copy + competitor price comparison (moved from josh) ---
# Read-only josh DB (the read replica, SELECT-only role). Unset = no catalog sync.
# Create it with: JOSH_PG_ADMIN_URL=<primary admin url> COMMERCE_PG_HOST=<replica host> node scripts/josh-postgres-readonly-user.mjs
JOSH_DATABASE_URL=
# josh's log Mongo (josh_logs: ERP inbound log, push-campaign delivery results), READ-ONLY user.
# Create it with: JOSH_MONGO_ROOT_URL=... COMMERCE_MONGO_HOST=<private ip> node scripts/josh-mongo-readonly-user.mjs
# Open josh's Mongo port only to commerce's security group / private IP — never the internet.
JOSH_MONGO_URL=
# CRON_JOSH_CATALOG_SYNC=*/15 * * * *
# CRON_JOSH_CATALOG_SYNC_ENABLED=true
# Off until cutover — josh refreshes its own copy until then.
CRON_COMPETITOR_PRICES_REFRESH_ENABLED=false
# CRON_COMPETITOR_PRICES_REFRESH=0 3 * * *

# --- Marketing Research (moved from josh) ---
# The external research worker calls /api/marketing-research-worker/* with this bearer (≥32 chars).
RESEARCH_WORKER_ENABLED=false
RESEARCH_WORKER_TOKEN=
RESEARCH_ENABLED_SOURCES=google
# Built-in free collector (TAT + OpenStreetMap). false until cutover — josh runs its own until then.
RESEARCH_FREE_WORKER_ENABLED=false
CRON_MARKETING_RESEARCH=* * * * *
CRON_MARKETING_RESEARCH_ENABLED=true
# AI summary runs only when Marketing clicks summarize. Backend secrets only; never send keys to the admin.
# Daily caps are per process here (no shared REDIS_CLIENT in commerce) — fine for one instance.
# RESEARCH_AI_ENABLED=true
# RESEARCH_GEMINI_API_KEYS= # JSON string array or comma-separated keys, priority order, max 5. Falls back to GEMINI_API_KEY.
# RESEARCH_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# RESEARCH_AI_DAILY_CALL_LIMIT=24
# Social research: free sources first; keys never go to the frontend.
# RESEARCH_SOCIAL_ENABLED=true
# RESEARCH_GOOGLE_NEWS_ENABLED=true # Public RSS titles/links only, no key.
# RESEARCH_PUBLIC_SOCIAL_RSS_ENABLED=true # Indexed public Facebook/Instagram/TikTok titles/links only; no platform API.
# RESEARCH_YOUTUBE_API_KEYS= # comma-separated, max 5; YouTube Data API v3.
# RESEARCH_YOUTUBE_DAILY_CALL_LIMIT=24
# RESEARCH_APIFY_ENABLED=false # optional Actor Tasks; keep disabled for free-only operation.
# RESEARCH_APIFY_API_TOKEN=
# RESEARCH_APIFY_TASKS=
# RESEARCH_APIFY_DAILY_RUN_LIMIT=4
# RESEARCH_APIFY_MAX_RUN_USD=0.05
# RESEARCH_APIFY_MONTHLY_BUDGET_USD=4

# --- MCP server for AI connectors (Claude / ChatGPT), read-only ---
# Public https origin AI clients reach (no path). Unset = MCP off.
# Serves /mcp, /authorize, /token, /register, /revoke, /mcp/oauth/login and /.well-known/oauth-* at the origin root.
MCP_PUBLIC_URL=
# Number of reverse proxies in front (e.g. 1 behind nginx) so login rate limits see the real client IP.
TRUST_PROXY_HOPS=

# --- Customer metrics (stage 2a): computed nightly here from josh_orders (order.snapshot copy), no josh DB read ---
# josh's API base (private network) + the same secret as josh's COMMERCE_EVENTS_SECRET.
JOSH_API_URL=
JOSH_EVENTS_SECRET=
# Opt-in. Runs 02:30 BKK, before josh's own 03:00 reconcile (which skips when josh has CUSTOMER_METRICS_OFFLOADED=true and this delivered < 26 h ago).
CRON_JOSH_CUSTOMER_METRICS_ENABLED=false
# CRON_JOSH_CUSTOMER_METRICS=30 2 * * *
# off = compute here only · shadow = josh compares and logs differences, writes nothing · on = josh applies them
CUSTOMER_METRICS_TO_JOSH=off
# Bestseller ranking for josh (Task 9): every 10 min on the replica; josh keeps each push 1h, else runs its own query
CRON_JOSH_BESTSELLERS_ENABLED=false
# CRON_JOSH_BESTSELLERS=0 */10 * * * *

# Alerts when events stop reaching platforms (josh): queue waiting too long, dead-letters, relay stuck.
# Any webhook that accepts {"text": "..."} — Slack / Google Chat / Teams incoming webhook. Empty = log only.
# Uptime monitors can poll GET /api/health/delivery (200 ok / 503 problem).
ALERT_WEBHOOK_URL=
# DELIVERY_ALERT_LAG_SECONDS=60
# OUTBOX_ALERT_LAG_SECONDS=30

# ERP simulator (admin → ERP simulator): sends real ERP calls through commerce to every platform.
# Always on outside production; on production only when set to true.
# ERP_SIMULATOR_ENABLED=false

# --- Orders -> Jagota through commerce, step 2 (josh JAGOTA_VIA_COMMERCE_BRANCHES routes branches here) ---
# Off unless true AND the Jagota API below is set; while off commerce answers 503 and josh sends directly.
JAGOTA_GATEWAY_ENABLED=false
# Same values as josh's. Staging: https://nodeapi-staging.jagota.com — prod files REAL orders.
JAGOTA_NODEAPI_BASE_URL=
JAGOTA_NODEAPI_USERNAME=
JAGOTA_NODEAPI_PASSWORD=

# --- Winback (the saleactivity sales app) run by commerce — docs/headless-split-plan.md "winback" ---
# josh (default): commerce mirrors josh's winback tables and refuses writes. commerce: commerce writes,
# runs the notify crons, mirrors its rows back to josh (`winback.row`). Flip with josh WINBACK_OWNED_BY_COMMERCE.
WINBACK_OWNER=josh
# josh's JWT_SECRET: the app keeps signing in at josh and sends josh's access token here.
JOSH_JWT_SECRET=
# Mirror josh ↔ commerce every 5 minutes (direction follows WINBACK_OWNER).
CRON_WINBACK_MIRROR_ENABLED=false
# Notify crons (only while WINBACK_OWNER=commerce) — same names / defaults as josh.
CRON_WINBACK_APPOINTMENTS_DUE_ENABLED=false
CRON_WINBACK_DAILY_DIGEST_ENABLED=false
CRON_WINBACK_AGING_LEADS_ENABLED=false
# WINBACK_APPOINTMENT_REMINDER_MINUTES=60
# WINBACK_LEAD_AGING_DAYS=3
# External lead form key (X-Winback-Key) — same value as josh's.
WINBACK_INTAKE_KEY=
# Activity photos: josh's media bucket / env names (no S3 → upload answers 503).
S3_MEDIA_BUCKET=
AWS_REGION=ap-southeast-7
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# MEDIA_BASE_URL=
