exports[`WinbackAppController contract route table 1`] = `
[
  "GET /winback/opportunities → listOpportunities",
  "GET /winback/opportunities/provinces → opportunityProvinces",
  "GET /winback/opportunities/filter-meta → opportunityFilterMeta",
  "GET /winback/opportunities/:id → opportunity",
  "POST /winback/opportunities/:id/convert → convertOpportunity",
  "GET /winback/opportunities/:id/meta → opportunityMeta",
  "PATCH /winback/opportunities/:id/meta → updateOpportunityMeta",
  "GET /winback/opportunities/:id/collaboration → opportunityCollaboration",
  "POST /winback/opportunities/:id/collaboration → createCollabRequest",
  "GET /winback/opportunities/:id/collaboration/logs → opportunityCollaborationLogs",
  "POST /winback/opportunities/:id/collaboration/messages → postCollabMessage",
  "PATCH /winback/opportunities/:id/collaboration/:requestId → resolveCollabRequest",
  "GET /winback/account/:id/opportunities → accountOpportunities",
  "GET /winback/collaboration/directory → collaborationDirectory",
  "GET /winback/collaboration/logs → collaborationLogs",
  "GET /winback/signals → listSignals",
  "POST /winback/signals/:id/complete → completeSignal",
  "POST /winback/signals/:id/snooze → snoozeSignal",
  "POST /winback/signals/:id/dismiss → dismissSignal",
  "GET /winback/account/:id/revenue-context → revenueContext",
  "GET /winback/products → products",
  "GET /winback/activities/:activityId/plan → appointmentPlan",
  "PUT /winback/activities/:activityId/plan → saveAppointmentPlan",
  "GET /winback/activities/:activityId/completion → visitCompletion",
  "PUT /winback/activities/:activityId/completion → saveVisitCompletion",
  "GET /winback/activities/:activityId/start-evidence → startEvidence",
  "PUT /winback/activities/:activityId/start-evidence → saveStartEvidence",
  "GET /winback/account/:id/joint-visits → jointVisits",
  "PUT /winback/activities/:activityId/joint-visit → saveJointVisit",
  "GET /winback/activity-drafts/:key → activityDraft",
  "PUT /winback/activity-drafts/:key → saveActivityDraft",
  "DELETE /winback/activity-drafts/:key → deleteActivityDraft",
  "GET /winback/coaching-tasks → coachingTasks",
  "POST /winback/coaching-tasks → createCoachingTask",
  "PATCH /winback/coaching-tasks/:id → updateCoachingTask",
  "GET /winback/teams → teams",
  "POST /winback/teams → createTeam",
  "PUT /winback/teams/:id → updateTeam",
  "DELETE /winback/teams/:id → deleteTeam",
  "GET /winback/work-plans → workPlans",
  "GET /winback/account/:id/work-plan → workPlan",
  "PUT /winback/account/:id/work-plan → saveWorkPlan",
  "GET /winback/saved-places → savedPlaces",
  "PUT /winback/saved-places/:placeId → savePlace",
  "DELETE /winback/saved-places/:placeId → unsavePlace",
  "GET /winback/discovery-query → discoveryQuery",
  "PUT /winback/discovery-query → saveDiscoveryQuery",
  "GET /winback/sync/sources → syncSources",
  "GET /winback/sync/runs → syncRuns",
  "GET /winback/quotes → quotes",
  "POST /winback/quotes → createQuote",
  "GET /winback/quotes/:id → quote",
  "PUT /winback/quotes/:id → reviseQuote",
  "POST /winback/quotes/:id/status → moveQuote",
  "POST /winback/quotes/:id/follow-up → followUpQuote",
  "GET /winback/quotes/:id/dispatches → quoteDispatches",
  "POST /winback/quotes/:id/dispatches → recordQuoteDispatch",
  "GET /winback/quote-terms → quoteTerms",
  "PUT /winback/quote-terms → saveQuoteTerms",
  "GET /winback/daily-reports → dailyReports",
  "GET /winback/daily-reports/:salesUserId/:day → dailyReport",
  "PUT /winback/daily-reports/:salesUserId/:day → saveDailyReport",
  "POST /winback/daily-reports/:salesUserId/:day/submit → submitDailyReport",
  "POST /winback/daily-reports/:salesUserId/:day/review → reviewDailyReport",
  "GET /winback/invoices → invoices",
]
`;
