# syntax=docker/dockerfile:1

FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install -g npm@11 && npm ci --ignore-scripts

FROM deps AS builder
COPY nx.json tsconfig.base.json ./
COPY apps/commerce-platform apps/commerce-platform

RUN npx nx build commerce-platform

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3100
# Scraping reader (moved from josh) drives Chromium through Playwright —
# same setup josh's backend image used.
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

RUN apk add --no-cache chromium && addgroup -S commerce && adduser -S commerce -G commerce

COPY --from=builder /app/dist/apps/commerce-platform/package.json ./package.json
COPY --from=builder /app/dist/apps/commerce-platform/src ./src
COPY --from=builder /app/node_modules ./node_modules

RUN chown -R commerce:commerce /app
USER commerce

EXPOSE 3100

CMD ["node", "src/main.js"]
