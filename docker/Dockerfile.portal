# syntax=docker/dockerfile:1

FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install -g npm@11 && npm ci --ignore-scripts

FROM deps AS builder

ARG VITE_COMMERCE_API_URL=https://commerce.joshapp.io/api

ENV VITE_COMMERCE_API_URL=$VITE_COMMERCE_API_URL

COPY nx.json tsconfig.base.json ./
COPY libs libs
COPY apps/commerce-portal apps/commerce-portal

RUN npx nx build commerce-portal

FROM nginx:1.27-alpine AS runner

COPY docker/nginx/commerce-portal.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist/apps/commerce-portal /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
